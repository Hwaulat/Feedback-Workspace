# ==========================================
# Supabase Configuration
# ==========================================
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_URL="https://your_supabase_project_id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# ==========================================
# Client Vite Injected Variables
# ==========================================
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_URL="https://your_supabase_project_id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_anon_key"

# ==========================================
# Application Security Secrets
# ==========================================
SESSION_SECRET="replace_with_32_chars_random_secret_key"
PIN_HASH_SECRET="replace_with_32_chars_random_secret_key"
ADMIN_PASSCODE="replace_with_secure_admin_passcode"

# ==========================================
# Database Connection (Optional / Migrations)
# ==========================================
# DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# ==========================================
# Docker Deployment (Used by GitLab CI/CD & Compose)
# ==========================================
CI_REGISTRY_IMAGE="registry.gitlab.com/your-group/your-project"
DOCKER_IMAGE_TAG="latest"
PORT=3000
LOCAL_PORT=3000
HOST=0.0.0.0
